{{> header}}

<h1>Travel Packages</h1>

{{#each trips}}
  <section style="margin-bottom: 30px;">
    <h2>{{this.name}}</h2>

    <p><strong>Code:</strong> {{this.code}}</p>
    <p><strong>Length:</strong> {{this.length}}</p>
    <p><strong>Start:</strong> {{this.start}}</p>
    <p><strong>Resort:</strong> {{this.resort}}</p>
    <p><strong>Per Person:</strong> ${{this.price}}</p>

    <p>{{this.description}}</p>

    <hr>
  </section>
{{/each}}

{{> footer}}
